DirectoryIndex index.php

<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

<IfModule mod_authz_core.c>
    <FilesMatch "(?i)^(?:\.|auth\.json|composer\.(?:json|lock)|package(?:-lock)?\.json|phpunit\.xml|phpstan\.neon|vite\.config\.js|eslint\.config\.js|components\.json|artisan)$">
        Require all denied
    </FilesMatch>

    <FilesMatch "(?i)\.(?:bak|conf|dist|ini|key|log|md|neon|pem|sql|sqlite|sqlite3|yaml|yml)$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
    <FilesMatch "(?i)^(?:\.|auth\.json|composer\.(?:json|lock)|package(?:-lock)?\.json|phpunit\.xml|phpstan\.neon|vite\.config\.js|eslint\.config\.js|components\.json|artisan)$">
        Order allow,deny
        Deny from all
    </FilesMatch>

    <FilesMatch "(?i)\.(?:bak|conf|dist|ini|key|log|md|neon|pem|sql|sqlite|sqlite3|yaml|yml)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Preserve bearer credentials for Laravel.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Allow ACME challenges used for HTTPS certificate validation.
    RewriteRule ^\.well-known(?:/|$) - [L]

    # Block hidden paths and all Laravel application directories.
    RewriteRule (^|/)\. - [F,L,NC]
    RewriteRule ^(?:app|bootstrap|config|database|deploy|docs|lang|node_modules|public|resources|routes|storage|tests|vendor)(?:/|$) - [F,L,NC]
    RewriteRule ^(?!index\.php$).*\.php$ - [F,L,NC]

    # Redirect trailing slashes unless the request points to a directory.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send application requests to the front controller in this directory.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

Options -Indexes
